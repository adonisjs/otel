{
  "name": "@adonisjs/otel",
  "description": "OpenTelemetry integration for AdonisJS with sensible defaults and zero-config setup",
  "version": "1.2.4",
  "engines": {
    "node": ">=22.15.0"
  },
  "type": "module",
  "homepage": "https://github.com/adonisjs/otel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adonisjs/otel.git"
  },
  "bugs": {
    "url": "https://github.com/adonisjs/otel/issues"
  },
  "files": [
    "build/src",
    "build/providers",
    "build/stubs",
    "build/index.d.ts",
    "build/index.js",
    "build/configure.d.ts",
    "build/configure.js"
  ],
  "exports": {
    ".": "./build/index.js",
    "./init": "./build/src/start.js",
    "./types": "./build/src/types/index.js",
    "./manager": "./build/src/otel.js",
    "./helpers": "./build/src/helpers.js",
    "./decorators": "./build/src/decorators.js",
    "./otel_provider": "./build/providers/otel_provider.js",
    "./otel_middleware": "./build/src/middleware/otel_middleware.js",
    "./instrumentations/container": "./build/src/instrumentations/container.js",
    "./instrumentations/events": "./build/src/instrumentations/events.js"
  },
  "scripts": {
    "clean": "del-cli build",
    "copy:templates": "copyfiles \"stubs/**/*.stub\" build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "quick:test": "node --import=./tsnode.esm.js --enable-source-maps bin/test.ts",
    "pretest": "npm run lint",
    "test": "npm run quick:test",
    "prebuild": "npm run lint && npm run clean",
    "build": "tsc",
    "checks": "npm run lint && npm run typecheck && npm run test",
    "postbuild": "npm run copy:templates",
    "release": "release-it",
    "version": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "adonisjs",
    "opentelemetry",
    "otel",
    "tracing",
    "observability",
    "metrics",
    "distributed-tracing",
    "instrumentation",
    "apm"
  ],
  "author": "Julien Ripouteau <julien@ripouteau.com>",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/auto-instrumentations-node": "^0.83.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/exporter-logs-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.301.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.301.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.1",
    "@opentelemetry/instrumentation": "^0.301.1",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "@poppinss/utils": "^7.1.2",
    "import-in-the-middle": "^3.6.0"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.6.0",
    "@adonisjs/auth": "^10.1.0",
    "@adonisjs/core": "^7.6.0",
    "@adonisjs/eslint-config": "3.1.0",
    "@adonisjs/prettier-config": "^1.5.0",
    "@adonisjs/tsconfig": "^2.0.0",
    "@japa/assert": "^4.2.0",
    "@japa/runner": "^5.4.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@swc/core": "^1.16.22",
    "@types/node": "^25.9.9",
    "c8": "^12.0.0",
    "copyfiles": "^2.4.1",
    "del-cli": "^8.0.1",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "release-it": "^21.1.2",
    "ts-node-maintained": "^10.9.6",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/auth": "^10.0.0",
    "@adonisjs/core": "^6.2.0 || ^7.0.0 || ^7.0.0-next.27"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    },
    "@adonisjs/auth": {
      "optional": true
    }
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "release-it": {
    "git": {
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commitMessage": "chore(release): ${version}",
      "tagAnnotation": "v${version}",
      "push": true,
      "tagName": "v${version}"
    },
    "github": {
      "release": true
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "c8": {
    "reporter": [
      "text",
      "html"
    ],
    "exclude": [
      "tests/**"
    ]
  },
  "prettier": "@adonisjs/prettier-config"
}
